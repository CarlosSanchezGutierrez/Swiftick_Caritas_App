# ==========================================
# Official Swift / Xcode / macOS .gitignore
# ==========================================

# Xcode User Data & State
# ==========================================
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Playgrounds & Workspaces
# ==========================================
markdown-preview.html
*.xctimeline
playground.xcworkspace

# Swift Package Manager (SPM)
# ==========================================
# Only ignore the build artifacts, keep Package.resolved if you want pinned versions
.build/
Packages/
.swiftpm/xcode/package.xcworkspace/
.swiftpm/xcode/xcuserdata/

# Package.resolved handling
# Un-comment the line below if you prefer to ignore dependency locks (not recommended for apps)
# Package.resolved

# Dependency Managers (Optional)
# ==========================================
# CocoaPods (Un-comment if you use CocoaPods)
# Pods/
# *.xcworkspace

# Carthage (Un-comment if you use Carthage)
# Carthage/Build/
# Carthage/Checkouts/

# Fastlane (Un-comment if you use Fastlane)
# fastlane/report.xml
# fastlane/Preview.html
# fastlane/screenshots/**/*.png
# fastlane/test_output

# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
